# Add this to your .zshrc to create aliases for switching between mouse and trackpad settings

# ... other content of .zshrc ...

# Aliases for switching between mouse and trackpad settings
# Make sure to make scripts executable (chmod +x switch-to-mouse.sh switch-to-trackpad.sh)
alias switch-to-mouse="/path/to/switch-to-mouse.sh"
alias switch-to-trackpad="/path/to/switch-to-trackpad.sh"
